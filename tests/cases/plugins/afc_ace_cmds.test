# AFC + AFC_ACE: lane settings, sensors, mapping, PREP, status through Jinja
CONFIG afc_ace_cmds.cfg
DICTIONARY atmega2560.dict

G4 P1000
SHOW_AFC
SET_COLOR LANE=lane1 COLOR=FF0000
SET_MATERIAL LANE=lane1 MATERIAL=PETG
SET_WEIGHT LANE=lane2 WEIGHT=750
SET_MAP LANE=lane2 MAP=T3
QUERY_FILAMENT_SENSOR SENSOR=extruder_tool_start
SET_FILAMENT_SENSOR SENSOR=extruder_tool_start ENABLE=0
QUERY_FILAMENT_SENSOR SENSOR=extruder_tool_start
AFC_CLEAR_MESSAGE
SHOW_AFC
AFC_RESET_MAPPING
PREP
AFC_M104 S=0
SHOW_AFC
M115
